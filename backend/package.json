{
  "name": "archivo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de contactos con SQLite",
  "scripts": {
    "dev": "node --watch --experimental-sqlite src/index.js",
    "start": "node --experimental-sqlite src/index.js",
    "test": "node --experimental-vm-modules --experimental-sqlite node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --experimental-sqlite node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --experimental-sqlite node_modules/jest/bin/jest.js --coverage",
    "test:int": "node --experimental-vm-modules --experimental-sqlite node_modules/jest/bin/jest.js --testPathPattern=\\.int\\.test\\.js$",
    "test:unit": "node --experimental-vm-modules --experimental-sqlite node_modules/jest/bin/jest.js --testPathIgnorePatterns=\\.int\\.test\\.js$"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
